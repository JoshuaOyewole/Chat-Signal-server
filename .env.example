PORT=3000
RING_TIMEOUT_MS=30000
HEARTBEAT_INTERVAL_MS=15000
HEARTBEAT_TIMEOUT_MS=10000

# Accounts (signup/login/calling) — required; see README's "Account setup".
# Neon (or any Postgres) connection string.
DATABASE_URL=
# Signs the 30-day accessToken. Any long random string — e.g.
# `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
JWT_SECRET=
# Salts OTP-code hashes. Same idea as JWT_SECRET; a different random string.
OTP_HASH_SECRET=

# Email (OTP delivery) — optional; leave unset to log OTP codes to the
# console instead of emailing them (fine for local dev, not for real users).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Townhall Hub <onboarding@resend.dev>

# Push (wake a closed app via FCM) — optional; leave unset to disable.
# Path to a Firebase service-account JSON file (keep the file itself out of
# git). On Render, use FIREBASE_SERVICE_ACCOUNT_JSON instead (paste the
# file's contents as a secret env var) since there's no file to point at.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
